+// Bionic has no POSIX shm_open/shm_unlink. Stats regions are opt-in and only read locally,
+// so named regions are emulated as plain files under $TMPDIR (or /data/local/tmp).
+#include <cstdlib>
+#include <string>
+static std::string FEXAndroidShmPath(const char* Name) {
+  const char* Dir = std::getenv("TMPDIR");
+  return std::string(Dir ? Dir : "/data/local/tmp") + "/" + Name;
+}
+static int shm_open(const char* Name, int Flags, mode_t Mode) {
+  return open(FEXAndroidShmPath(Name).c_str(), Flags, Mode);
+}
+static int shm_unlink(const char* Name) {
+  return unlink(FEXAndroidShmPath(Name).c_str());
+}
+#endif
