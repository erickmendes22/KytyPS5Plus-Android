+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: Folds guest memory addresses with FEXCore::GuestAddressFold's mask (Kyty Android port)
+$end_info$
+*/
+
+#include "Interface/IR/IR.h"
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "Interface/IR/Passes.h"
+
+#include <FEXCore/Core/GuestAddressFold.h>
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/Profiler.h>
+
+#include <atomic>
+#include <bit>
+
+namespace FEXCore::GuestAddressFold {
+namespace {
+  std::atomic<uint64_t> CurrentMask {0};
+}
+
+void SetMask(uint64_t Mask) {
+  CurrentMask.store(Mask, std::memory_order_release);
+}
+
+uint64_t GetMask() {
+  return CurrentMask.load(std::memory_order_acquire);
+}
+} // namespace FEXCore::GuestAddressFold
+
+namespace FEXCore::IR {
+namespace {
+
+  // Immediate offsets up to this size are kept on the access: folding the base alone is then
+  // equivalent to folding the sum unless base and offset straddle a fold boundary.
+  constexpr int64_t KeepImmediateLimit = int64_t {1} << 20;
+
+  class GuestAddressFold final : public Pass {
+  public:
+    void Run(IREmitter* IREmit) override;
+
+  private:
+    // Replaces Args[AddrIndex] with Args[AddrIndex] & Mask.
+    void FoldBase(IREmitter* IREmit, Ref CodeNode, IROp_Header* IROp, uint8_t AddrIndex, uint64_t Mask);
+
+    // Folds Addr + extend(Offset) << Scale as a whole and drops the offset, unless the offset is a
+    // small immediate, in which case only the base is folded.
+    template<typename T>
+    void FoldBaseAndOffset(IREmitter* IREmit, Ref CodeNode, IROp_Header* IROp, uint64_t Mask);
+  };
+
+  void GuestAddressFold::FoldBase(IREmitter* IREmit, Ref CodeNode, IROp_Header* IROp, uint8_t AddrIndex, uint64_t Mask) {
+    if (IROp->Args[AddrIndex].IsInvalid()) {
+      return;
+    }
+    auto CurrentIR = IREmit->ViewIR();
+    Ref Addr = CurrentIR.GetNode(IROp->Args[AddrIndex]);
+    IREmit->SetWriteCursorBefore(CodeNode);
+    Ref Folded = IREmit->_And(OpSize::i64Bit, Addr, IREmit->_InlineConstant(Mask));
+    IREmit->ReplaceNodeArgument(CodeNode, AddrIndex, Folded);
+  }
+
+  template<typename T>
+  void GuestAddressFold::FoldBaseAndOffset(IREmitter* IREmit, Ref CodeNode, IROp_Header* IROp, uint64_t Mask) {
+    auto* Op = IROp->CW<T>();
+    if (Op->Offset.IsInvalid()) {
+      FoldBase(IREmit, CodeNode, IROp, T::Addr_Index, Mask);
+      return;
+    }
+
+    auto CurrentIR = IREmit->ViewIR();
+    Ref Offset = CurrentIR.GetNode(Op->Offset);
+    uint64_t Imm {};
+    if (IREmit->IsValueInlineConstant(Op->Offset) || IREmit->IsValueConstant(Op->Offset, &Imm)) {
+      if (IREmit->IsValueInlineConstant(Op->Offset)) {
+        Imm = CurrentIR.GetOp<IROp_InlineConstant>(Op->Offset)->Constant;
+      }
+      const auto Scaled = static_cast<int64_t>(Imm) * static_cast<int64_t>(Op->OffsetScale);
+      if (Op->OffsetType == MemOffsetType::SXTX && Scaled > -KeepImmediateLimit && Scaled < KeepImmediateLimit) {
+        FoldBase(IREmit, CodeNode, IROp, T::Addr_Index, Mask);
+        return;
+      }
+    }
+
+    Ref Addr = CurrentIR.GetNode(Op->Addr);
+    IREmit->SetWriteCursorBefore(CodeNode);
+    Ref Extended = Offset;
+    if (IREmit->IsValueInlineConstant(Op->Offset)) {
+      Extended = IREmit->_Constant(CurrentIR.GetOp<IROp_InlineConstant>(Op->Offset)->Constant);
+    }
+    switch (Op->OffsetType) {
+    case MemOffsetType::UXTW: Extended = IREmit->_Bfe(OpSize::i64Bit, 32, 0, Extended); break;
+    case MemOffsetType::SXTW: Extended = IREmit->_Sbfe(OpSize::i64Bit, 32, 0, Extended); break;
+    case MemOffsetType::SXTX: break;
+    }
+    const auto Shift = static_cast<uint8_t>(std::countr_zero(static_cast<uint32_t>(Op->OffsetScale)));
+    Ref Sum = IREmit->_AddShift(OpSize::i64Bit, Addr, Extended, ShiftType::LSL, Shift);
+    Ref Folded = IREmit->_And(OpSize::i64Bit, Sum, IREmit->_InlineConstant(Mask));
+    IREmit->ReplaceNodeArgument(CodeNode, T::Addr_Index, Folded);
+    IREmit->ReplaceNodeArgument(CodeNode, T::Offset_Index, IREmit->Invalid());
+    Op->OffsetType = MemOffsetType::SXTX;
+    Op->OffsetScale = 1;
+  }
+
+  void GuestAddressFold::Run(IREmitter* IREmit) {
+    const uint64_t Mask = FEXCore::GuestAddressFold::GetMask();
+    if (Mask == 0) {
+      return;
+    }
+    FEXCORE_PROFILE_SCOPED("PassManager::GuestAddressFold");
+
+    auto CurrentIR = IREmit->ViewIR();
+    for (auto [CodeNode, IROp] : CurrentIR.GetAllCode()) {
+      switch (IROp->Op) {
+      case OP_LOADMEM: FoldBaseAndOffset<IROp_LoadMem>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_STOREMEM: FoldBaseAndOffset<IROp_StoreMem>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_LOADMEMTSO: FoldBaseAndOffset<IROp_LoadMemTSO>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_STOREMEMTSO: FoldBaseAndOffset<IROp_StoreMemTSO>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_VLOADVECTORMASKED: FoldBaseAndOffset<IROp_VLoadVectorMasked>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_VSTOREVECTORMASKED: FoldBaseAndOffset<IROp_VStoreVectorMasked>(IREmit, CodeNode, IROp, Mask); break;
+      case OP_STORESTACKMEM: FoldBaseAndOffset<IROp_StoreStackMem>(IREmit, CodeNode, IROp, Mask); break;
+
+      case OP_LOADMEMPAIR: FoldBase(IREmit, CodeNode, IROp, IROp_LoadMemPair::Addr_Index, Mask); break;
+      case OP_STOREMEMPAIR: FoldBase(IREmit, CodeNode, IROp, IROp_StoreMemPair::Addr_Index, Mask); break;
+      case OP_STOREMEMX87SVEOPTPREDICATE: FoldBase(IREmit, CodeNode, IROp, IROp_StoreMemX87SVEOptPredicate::Addr_Index, Mask); break;
+      case OP_LOADMEMX87SVEOPTPREDICATE: FoldBase(IREmit, CodeNode, IROp, IROp_LoadMemX87SVEOptPredicate::Addr_Index, Mask); break;
+      case OP_VLOADVECTORGATHERMASKED: FoldBase(IREmit, CodeNode, IROp, IROp_VLoadVectorGatherMasked::AddrBase_Index, Mask); break;
+      case OP_VLOADVECTORGATHERMASKEDQPS: FoldBase(IREmit, CodeNode, IROp, IROp_VLoadVectorGatherMaskedQPS::AddrBase_Index, Mask); break;
+      case OP_VLOADVECTORELEMENT: FoldBase(IREmit, CodeNode, IROp, IROp_VLoadVectorElement::Addr_Index, Mask); break;
+      case OP_VSTOREVECTORELEMENT: FoldBase(IREmit, CodeNode, IROp, IROp_VStoreVectorElement::Addr_Index, Mask); break;
+      case OP_VBROADCASTFROMMEM: FoldBase(IREmit, CodeNode, IROp, IROp_VBroadcastFromMem::Address_Index, Mask); break;
+      case OP_CACHELINECLEAR: FoldBase(IREmit, CodeNode, IROp, IROp_CacheLineClear::Addr_Index, Mask); break;
+      case OP_CACHELINECLEAN: FoldBase(IREmit, CodeNode, IROp, IROp_CacheLineClean::Addr_Index, Mask); break;
+      case OP_CACHELINEZERO: FoldBase(IREmit, CodeNode, IROp, IROp_CacheLineZero::Addr_Index, Mask); break;
+      case OP_VSTORENONTEMPORAL: FoldBase(IREmit, CodeNode, IROp, IROp_VStoreNonTemporal::Addr_Index, Mask); break;
+      case OP_VSTORENONTEMPORALPAIR: FoldBase(IREmit, CodeNode, IROp, IROp_VStoreNonTemporalPair::Addr_Index, Mask); break;
+      case OP_VLOADNONTEMPORAL: FoldBase(IREmit, CodeNode, IROp, IROp_VLoadNonTemporal::Addr_Index, Mask); break;
+
+      case OP_CAS: FoldBase(IREmit, CodeNode, IROp, IROp_CAS::Addr_Index, Mask); break;
+      case OP_CASPAIR: FoldBase(IREmit, CodeNode, IROp, IROp_CASPair::Addr_Index, Mask); break;
+      case OP_ATOMICSWAP: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicSwap::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHADD: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchAdd::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHSUB: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchSub::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHAND: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchAnd::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHCLR: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchCLR::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHOR: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchOr::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHXOR: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchXor::Addr_Index, Mask); break;
+      case OP_ATOMICFETCHNEG: FoldBase(IREmit, CodeNode, IROp, IROp_AtomicFetchNeg::Addr_Index, Mask); break;
+
+      // Not folded here:
+      // - Push/PushTwo/Pop/PopTwo return the updated stack pointer, which must stay unfolded; guest
+      //   stacks are allocated by the frontend below the fold boundary.
+      // - MemSet/MemCpy return the updated RDI/RSI; the OpcodeDispatcher folds their inputs and
+      //   restores the high bits of the results.
+      // - Prefetch cannot fault.
+      default: break;
+      }
+    }
+  }
+
+} // namespace
+
+fextl::unique_ptr<Pass> CreateGuestAddressFoldPass() {
+  return fextl::make_unique<GuestAddressFold>();
+}
+
+} // namespace FEXCore::IR
