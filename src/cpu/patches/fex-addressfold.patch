+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <cstdint>
+
+// Guest address folding (Kyty Android port).
+//
+// On hosts whose user address space is smaller than what a guest reserves (a 39-bit Android
+// kernel against a PS5 game that reserves 512 GiB), the frontend can ask the JIT to fold every
+// guest memory access: the effective address is ANDed with a mask before the access, so guest
+// address A is backed by host address A & Mask. Guest register values are never changed; only the
+// address an access uses is.
+//
+// A mask of 0 disables folding (the default). Blocks are compiled with the mask current at
+// compile time, so the caller must invalidate already compiled code when it enables folding.
+namespace FEXCore::GuestAddressFold {
+
+FEX_DEFAULT_VISIBILITY void SetMask(uint64_t Mask);
+FEX_DEFAULT_VISIBILITY uint64_t GetMask();
+
+} // namespace FEXCore::GuestAddressFold
